# Copy to .env and fill in before deploying. Never commit .env.

# Deployer key. This address pays gas in USDC (18-decimal native token) and
# becomes the default fee recipient / owner unless overridden below.
# Fund it with testnet USDC from https://faucet.circle.com
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional overrides — default to the deployer address if unset.
FEE_RECIPIENT=0xYOUR_TREASURY_ADDRESS
PROTOCOL_OWNER=0xYOUR_ADMIN_ADDRESS

# Only needed if/when ArcScan exposes a verification API (see foundry.toml).
# ARCSCAN_API_KEY=
