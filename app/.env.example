# Copy to .env and fill in. Vite only exposes vars prefixed VITE_ to the client.

# Address printed by `forge script script/Deploy.s.sol:Deploy` in /contracts.
# Leave unset to run the app in "not deployed" mode (UI renders, all write
# actions are disabled with an explanatory banner instead of failing silently).
VITE_DUELINK_CORE_ADDRESS=

# Free at https://cloud.walletconnect.com — enables WalletConnect's
# mobile-wallet QR flow inside ConnectKit. Without it, browser-injected
# wallets (MetaMask, Rabby, Coinbase extension) still work.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: Circle Developer-Controlled Wallets, for email-based onboarding
# with no seed phrase (PRD §9.1 / §6.3). Requires a Circle Developer account:
# https://console.circle.com — get an API key and a Wallet Set / App ID.
# Left unset, the "Continue with email" option in the wallet connect modal
# is shown but disabled with a tooltip pointing here. See
# src/lib/circleWallets.ts for the integration point and TODOs.
VITE_CIRCLE_APP_ID=
VITE_CIRCLE_API_KEY=